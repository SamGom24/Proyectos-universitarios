# ============================================================
#  backend/.env.example
#  Copia este archivo como .env y rellena los valores reales.
#  NUNCA subas el archivo .env a Git.
# ============================================================

# --- Base de datos PostgreSQL (local, sin Docker) ---
DATABASE_URL=postgresql+psycopg://TU_USUARIO:TU_PASSWORD@localhost:5432/himalaya_db

# --- Seguridad ---
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Entorno ---
# "development" | "production" | "testing"
ENVIRONMENT=development
